{
  "name": "af/promotion-feedback",
  "description": "Shows specific and understandable reasons when a promo code cannot be applied (expired campaign, inactive, not started, wrong sales channel, already redeemed).",
  "type": "shopware-platform-plugin",
  "version": "0.1.0",
  "license": "MIT",
  "require": {
    "shopware/core": ">=6.7.13.0"
  },
  "extra": {
    "shopware-plugin-class": "Af\\PromotionFeedback\\AfPromotionFeedback",
    "label": {
      "de-DE": "AfPromotionFeedback – Gutschein-Fehlermeldungen",
      "en-GB": "AfPromotionFeedback – Promo code error messages"
    }
  },
  "autoload": {
    "psr-4": {
      "Af\\PromotionFeedback\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Af\\PromotionFeedback\\Tests\\": "tests/"
    }
  }
}